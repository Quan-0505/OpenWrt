msgstr "用户名"

msgid "Wallpaper"
msgstr "壁纸"

msgid "Warning"
msgstr "警告"

msgid "You must enable JavaScript in your browser or LuCI will not work properly."
msgstr "您必须在浏览器中启用 JavaScript，否则 LuCI 将无法正常工作。"

msgid "in the sidebar"
msgstr "位于侧边栏"

msgid "on a card"
msgstr "位于卡片上"

msgid "on a control"
msgstr "位于控件上"

msgid "on the canvas"
msgstr "位于画布上"

msgid "the uploaded file could not be removed either; it is still on the router."
msgstr "上传的文件也无法删除，它仍保留在路由器上。"

