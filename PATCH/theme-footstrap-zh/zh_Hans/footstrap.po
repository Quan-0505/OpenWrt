msgstr "系统正在以恢复（initramfs）模式运行。"

msgid "Table"
msgstr "表格"

msgid "That SVG contains script or external references, which this theme will not install."
msgstr "该 SVG 包含脚本或外部引用，本主题不会安装它。"

msgid "That file could not be read."
msgstr "无法读取该文件。"

msgid "That file is not a readable image."
msgstr "该文件不是可读取的图片。"

msgid "That file is not an SVG image."
msgstr "该文件不是 SVG 图片。"

msgid "That file is too large."
msgstr "该文件太大。"

msgid "That image is too large."
msgstr "该图片太大。"

msgid "The router refused to delete the file (ubus status %d)."
msgstr "路由器拒绝删除该文件（ubus 状态 %d）。"

msgid "Theme"
msgstr "主题"

msgid "There is no password set on this router. Please configure a root password to protect the web interface."
msgstr "此路由器未设置密码。请配置 root 密码以保护 Web 界面。"

msgid "This browser is not storing preferences (site data is blocked), so a change here lasts until you reload. Saving as default still works and applies to every browser."
msgstr "当前浏览器未保存偏好设置（站点数据被阻止），因此此处的更改仅在刷新前有效。「保存为默认」仍会生效并作用于所有浏览器。"

msgid "This theme is not translated on this router yet."
msgstr "此主题尚未提供该语言翻译。"

msgid "Tint (router identification)"
msgstr "色调（路由器标识）"

msgid "Tint strength"
msgstr "色调强度"

msgid "Too faint to read %s"
msgstr "过淡难以阅读 %s"

msgid "Top"
msgstr "顶部"

msgid "Upload failed."
msgstr "上传失败。"

