config kixdns-web 'main'
	option enabled '1'
	# HTTP listen address for the console
	option listen '0.0.0.0:8080'
	# Start kixdns with --debug so the observer events that feed the dashboard
	# are produced. Without it every counter stays 0.
	option debug '1'
	# Optional shared secret. When set, requests must carry
	# "X-Auth-Token: <token>" or "?token=<token>".
	option token ''
	# Set to 1 to disable config writes and service start/stop from the UI.
	option readonly '0'
