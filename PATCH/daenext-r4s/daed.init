#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load daed
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	mkdir -p /etc/daed /tmp/log/daed
	chmod 750 /etc/daed
	# Logs live in RAM; the configuration database stays in persistent storage.
	[ -e /etc/daed/logs ] || ln -s /tmp/log/daed /etc/daed/logs
	procd_open_instance
	procd_set_param command /usr/bin/daed run -c /etc/daed/ --state /etc/daed/daed.db --web-root /usr/share/daed/web
	procd_set_param respawn
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/bin/daed reload
}

service_triggers() {
	procd_add_reload_trigger daed
}
